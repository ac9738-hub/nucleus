{
  "name": "nucleus",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js tests/renderer/*.test.js",
    "test:renderer": "node --test tests/renderer/*.test.js",
    "eval:task-optimizer": "node task_optimizer_iteration/run.js",
    "test:context": "node --test tests/context-store.test.js tests/context-index.test.js tests/text-chunks.test.js && python tests/test_format_context_snapshot.py",
    "test:canvas-preload": "node --test tests/renderer/canvas-preload-planner.test.js tests/renderer/canvas-preload-slot-pool.test.js tests/renderer/canvas-preload-dom.test.js tests/renderer/canvas-preload-native.test.js tests/renderer/canvas-preload-native-tracker.test.js tests/renderer/canvas-preload-graph.test.js tests/renderer/canvas-preload-metrics.test.js tests/renderer/canvas-preload-modules.test.js tests/renderer/canvas-nav-stack.test.js tests/renderer/canvas-preload-pointer.test.js",
    "eval:canvas-preload": "node scripts/eval_canvas_preload.js",
    "eval:canvas-preload-hitrate": "node scripts/eval_canvas_preload_hitrate.js",
    "test:app-fork": "node --test tests/app-fork/framework.test.js tests/app-fork/load-timing.test.js tests/app-fork/gpu-pressure.test.js tests/app-fork/race-activation.test.js tests/app-fork/race-preload.test.js tests/app-fork/race-renderer-main.test.js tests/app-fork/screen-state.test.js tests/app-fork/integration-scenarios.test.js tests/app-fork/stress-preload.test.js tests/app-fork/stress-tabs.test.js tests/app-fork/stress-workspaces.test.js",
    "eval:app-fork": "node scripts/eval_app_fork.js",
    "eval:app-fork:strict": "node scripts/eval_app_fork.js --profile strict",
    "eval:app-fork:load": "node scripts/eval_app_fork.js --scenario load",
    "eval:app-fork:gpu": "node scripts/eval_app_fork.js --scenario gpu",
    "eval:app-fork:races": "node scripts/eval_app_fork.js --scenario races",
    "test:app-fork:stress": "node --test tests/app-fork/stress-preload.test.js tests/app-fork/stress-tabs.test.js tests/app-fork/stress-workspaces.test.js",
    "eval:app-fork:stress": "node scripts/eval_app_fork.js --scenario stress",
    "eval:app-fork:stress:strict": "node scripts/eval_app_fork.js --scenario stress --profile strict",
    "reparse:pdf-blocks": "python scripts/reparse_pdf_blocks.py",
    "reparse:pdf-blocks:dry": "python scripts/reparse_pdf_blocks.py --dry-run",
    "eval:chunks": "python scripts/eval_text_chunking.py --fixture",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "start:default": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_THEME=default&& electron .",
    "start:dark": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_THEME=dark&& electron .",
    "start:white": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_THEME=white&& electron .",
    "start:debug": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_DEBUG=all&& electron .",
    "start:perf": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_PERF_SERVER=1&& set NUCLEUS_PERF_SERVER_PORT=8790&& electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.1.0",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "@datastructures-js/priority-queue": "^6.3.5",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "googleapis": "^173.0.0"
  }
}
