{
  "name": "nucleus",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:context": "node --test tests/*.test.js && python tests/test_format_context_snapshot.py",
    "reparse:pdf-blocks": "python scripts/reparse_pdf_blocks.py",
    "reparse:pdf-blocks:dry": "python scripts/reparse_pdf_blocks.py --dry-run",
    "eval:context": "node scripts/evaluate-context.js",
    "eval:context:full": "node scripts/run-context-eval.js",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "start:default": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_THEME=default&& electron .",
    "start:dark": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_THEME=dark&& electron .",
    "start:white": "set ELECTRON_RUN_AS_NODE=&& set NUCLEUS_THEME=white&& electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.1.0"
  },
  "dependencies": {
    "@datastructures-js/priority-queue": "^6.3.5",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "googleapis": "^173.0.0"
  }
}
