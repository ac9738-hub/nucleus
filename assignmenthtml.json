ed datepicker */\n\n.react-datepicker {\n    border-radius: 12px;\n    box-shadow: 0px 0px 6px 0px #2320201a;\n    font-family: InterMedium, Roboto, Segoe UI, Oxygen, Ubuntu, Cantarell,\n        Fira Sans, Droid Sans, Helvetica Neue, sans-serif;\n}\n\n.month-picker-container {\n    height: 33px;\n}\n\n.month-picker-icon-container {\n    position: relative;\n    pointer-events: none;\n    width: 100%;\n    height: 100%;\n    margin-top: -33px;\n}\n\n.month-picker-icon {\n    background-repeat: no-repeat;\n    background-size: cover;\n    background-image: url(data:image/svg+xml;base64,);\n    position: absolute;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    margin-top: auto;\n    margin-bottom: auto;\n    width: 22px;\n    height: 22px;\n    margin-right: 5px;\n}\n\n.react-datepicker__input-container input {\n    height: 34px;\n    cursor: pointer;\n    border: 1px solid #c9bdbd;\n    border-radius: 4px;\n    font-family: InterMedium, Roboto, Segoe UI, Oxygen, Ubuntu, Cantarell,\n        Fira Sans, Droid Sans, Helvetica Neue, sans-serif;\n    padding: 10px;\n    font-size: 15px;\n    line-height: 1.5;\n    width: 165px;\n    box-sizing: border-box;\n}\n\n.react-datepicker__input-container input:hover {\n    border: 1px solid black;\n}\n\n.react-datepicker__input-container input:focus-visible {\n    border: 2px solid #0b6f85;\n    outline: none;\n}\n\n.react-datepicker-customize {\n    border-radius: 5px;\n    border: none;\n    box-shadow: 0px 0px 4px 0px #00000040;\n    font-family: InterMedium, Roboto, Segoe UI, Oxygen, Ubuntu, Cantarell,\n        Fira Sans, Droid Sans, Helvetica Neue, sans-serif;\n    padding: 5px 10px;\n}\n\n.react-datepicker__navigation--next {\n    right: 0;\n    width: 8px;\n    height: 16px;\n    border: none;\n    background-repeat: no-repeat;\n    background-size: contain;\n    background-image: url(data:image/svg+xml;base64,);\n}\n\n.react-datepicker__navigation--previous {\n    left: 0;\n    width: 8px;\n    height: 16px;\n    border: 