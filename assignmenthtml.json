\n    filter: none;\n}\n\n.event-banner-content {\n    display: flex;\n    flex-direction: row;\n    gap: 5px;\n    align-items: center;\n    padding: 9px;\n}\n\n.event-banner-prefix {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    background-image: linear-gradient(315deg, #dfd1ff, #b2ffff);\n    background-clip: text;\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.event-banner-title {\n    font-size: 16px;\n    color: #efefef;\n    margin-right: 13px;\n}\n.event-banner-link {\n    color: #11007a !important;\n    font-size: 14px !important;\n    align-items: center;\n    display: flex;\n    flex-direction: row;\n    gap: 6px;\n}\n.banner-stars-start {\n    position: absolute;\n    top: -13px;\n    left: 0px;\n    height: 70px;\n}\n.banner-stars-end {\n    position: absolute;\n    top: -13px;\n    right: 0px;\n    height: 70px;\n}\n\n.event-banner-stars-container {\n    position: absolute;\n    left: 0px;\n    right: 0px;\n    top: 0px;\n    bottom: 0px;\n    display: flex;\n    flex-direction: row;\n    justify-content: space-around;\n    align-items: center;\n}\n\n.common-primary-banner {\n    display: flex;\n    flex-direction: row;\n    gap: 10px;\n    padding: 10px;\n    border-radius: 10px;\n\n    background-color: #f9f8ff;\n    border: 1px solid #c0b9ec;\n\n    color: #333333;\n}\n\n.common-primary-banner > svg {\n    min-width: 24px;\n    transform: scaleX(-100%);\n}\n\n.lms-banner-container {\n    display: flex;\n    background: linear-gradient(180deg, #fbf8ff 0%, #f4f1ff 100%);\n    border: 2px solid #ebddff;\n    border-radius: 12px;\n    padding: 15px;\n}\n\n.lms-banner-container.canvas {\n    margin-bottom: 10px;\n}\n.lms-banner-container.d2l {\n    margin-top: 30px;\n}\n.lms-banner-container.d2l .lms-banner-content {\n    font-size: medium;\n}\n.lms-banner-container.bb-original {\n    margin-left: 30px;\n    margin-right: 30px;\n}\n\n.lms-banner-title {\n    all: unset;\n    