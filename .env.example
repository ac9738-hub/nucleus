# Copy this file to .env and fill in your Canvas values.
# Do not commit .env.

# Your Canvas domain, with no trailing slash.
CANVAS_BASE_URL='https://princeton.instructure.com'

# Session cookie from browser DevTools (weekly iteration fetch + parser refresh).
CANVAS_AUTH_COOKIE=
CANVAS_AUTH_CSRF=

# Holdout student (separate Canvas account) — used with --holdout flags.
# Falls back to CANVAS_BASE_URL when CANVAS_BASE_URL_HOLDOUT is unset.
CANVAS_AUTH_COOKIE_HOLDOUT=
CANVAS_AUTH_CSRF_HOLDOUT=
CANVAS_BASE_URL_HOLDOUT=

# Preferred once you have it.
CANVAS_ACCESS_TOKEN=

# Parser LLM passes (only needed for --refresh-graph).
DEEP_SEEK_API_KEY=

# Optional resource caps (defaults shown; increase for very large courses).
# CANVAS_MAX_PAGINATION_PAGES=50
# CANVAS_MAX_PAGINATION_ITEMS=5000
# CANVAS_MAX_PAGE_BODY_FETCHES=250
# PARSER_MAX_BATCH_ITEMS=50
# CANVAS_FETCH_TIMEOUT_MS=60000
# CANVAS_DOWNLOAD_TIMEOUT_SECONDS=120
# CANVAS_DOWNLOAD_MAX_BYTES=104857600
# DEEPSEEK_TIMEOUT_SECONDS=180
# PARSER_TASK_REFRESH_MS=2000

# Only needed if you want canvas.py to exchange an OAuth auth code.
CANVAS_AUTH_CODE=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=
