# Copy this file to .env and fill in your Canvas values.
# Do not commit .env.

# Holistic render + resource diagnostics (Electron app).
# NUCLEUS_DEBUG=all enables JSONL logs under .cache/diagnostics/
# Channels: render, pool, ipc, tabs, layout, lifecycle, error
# NUCLEUS_DEBUG=
# NUCLEUS_DEBUG_CONSOLE=1
# NUCLEUS_DEBUG_FILE=1

# Canvas white-flash diagnostics — JSONL under .cache/canvas_flash/trace.jsonl
# NUCLEUS_FLASH_TRACE=1

# Fake system clock for local dev (main process, renderer, parser). Mid spring ≈ March.
# Remove or comment out to use real time.
NUCLEUS_FAKE_DATE=2026-03-15T12:00:00

# Your Canvas domain, with no trailing slash.
CANVAS_BASE_URL='https://princeton.instructure.com'

# Session cookie from browser DevTools (weekly iteration fetch + parser refresh).
CANVAS_AUTH_COOKIE=
CANVAS_AUTH_CSRF=

# Holdout student (separate Canvas account) — used with --holdout flags.
# Falls back to CANVAS_BASE_URL when CANVAS_BASE_URL_HOLDOUT is unset.
CANVAS_AUTH_COOKIE_HOLDOUT=
CANVAS_AUTH_CSRF_HOLDOUT=
CANVAS_BASE_URL_HOLDOUT=

# Preferred once you have it.
CANVAS_ACCESS_TOKEN=

# Parser LLM passes (only needed for --refresh-graph).
DEEP_SEEK_API_KEY=

# Parser placement (default: Lambda course orchestration from canvas_data.json).
#   local_download_lambda_parse — local auth in payload → Lambda download+parse (default)
#   lambda_download_parse       — Lambda uses deployed Canvas auth + item URLs
#   local_subprocess              — legacy parser.py stdin subprocess
# PARSER_PLACEMENT=local_download_lambda_parse
# PARSER_TIMEOUT_SEC=7200
# IAM: Lambda, S3, iam:CreateRole, iam:PutRolePolicy, iam:PassRole, ec2:ImportKeyPair (not needed for Lambda)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Gmail OAuth (optional; defaults to bundled dev client if unset).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/callback

# Optional OCR (PDF figures + PNG/JPG handouts). Requires system tesseract binary.
# pytesseract
# Pillow
# olefile  # legacy .doc/.ppt text extraction
# CHUNK_EMBED_MAX=32
# NUCLEUS_OCR=1
# CANVAS_MAX_PAGINATION_PAGES=80
# CANVAS_MAX_PAGINATION_ITEMS=8000
# CANVAS_MAX_PAGE_BODY_FETCHES=400
# PARSER_MAX_BATCH_ITEMS=50
# CANVAS_FETCH_TIMEOUT_MS=60000
# CANVAS_DOWNLOAD_TIMEOUT_SECONDS=120
# CANVAS_DOWNLOAD_MAX_BYTES=104857600
# DEEPSEEK_TIMEOUT_SECONDS=180
# PARSER_TASK_REFRESH_MS=2000
# PARSER_PASS1_MAX_PROMPT_TOKENS=200000
# PARSER_PASS1_MAX_PROMPT_CHARS=800000
# PARSER_CHARS_PER_TOKEN=4
# PARSER_PASS1_MAX_PAGES=120
# PARSER_PASS1_LINKED_MAX_PAGES=40
# PARSER_ACADEMIC_NORMALIZE=1
# PARSER_ACADEMIC_HEADER_FOOTER_RATIO=0.55
# PARSER_LINKED_FILE_MODE=light
# PARSER_ABORT_ON_BALANCE=1        # abort bulk parse on first DeepSeek 402 (default on when PARSER_BULK_MODE=1)
# PARSER_BALANCE_ABORT_AFTER=1     # consecutive 402 strikes before abort
# PARSER_HEURISTIC_CONCEPTS=1        # deterministic pre-LLM concept seed (default on in quality mode)
# PARSER_HEURISTIC_MAX_PER_FILE=80   # cap heuristic seeds per file (high-confidence first)
# PARSER_HEURISTIC_ALLOW_MEDIUM=1    # allow teaching-block short headings (0=stricter)
# PARSER_LLM_RETRY_DELAYS_SEC=2,5,15  # backoff seconds for DeepSeek 429 rate limits
# PARSER_KEYWORD_EXTRACT=0
# PARSER_KEYWORD_EXTRACT=auto
# PARSER_KEYWORD_MAX_CHARS=120000
# PARSER_KEYWORD_MIN_INPUT=30000
# PARSER_CLASSIFY_SNIPPET_CHARS=2800
# PARSER_CLASSIFY_HEURISTIC_THRESHOLD=0.82
# PARSER_FORCE_LLM_CLASSIFY=0
# DeepSeek V4 Flash parse cost estimates ($/1M tokens; official api-docs.deepseek.com)
# PARSER_DEEPSEEK_INPUT_CACHE_HIT_PER_M=0.0028
# PARSER_DEEPSEEK_INPUT_CACHE_MISS_PER_M=0.14
# PARSER_DEEPSEEK_OUTPUT_PER_M=0.28

# Fast full reparse (time >> cost; see scripts/run_full_reparse_canvas_data.py)
# PARSER_SKIP_PASS2=1              # ~40-50% less LLM time; skip pass-2 enrichment on file types that use it
# PARSER_DEFER_FILE_EMBED=1        # skip per-file embedding; run scripts/reembed_graph.py after parse
# PARSER_DEFER_CHECKPOINT=1        # skip checkpoint write after every batch (faster; less resume safety)
# PARSE_MAX_CONCURRENT=12          # default 8; raise if API rate limits allow
# DEEPSEEK_MAX_CONCURRENT=16       # default 10
# DEEPSEEK_MAX_TURNS_PASS=2        # default 3; fewer tool rounds per pass

# Only needed if you want canvas.py to exchange an OAuth auth code.
CANVAS_AUTH_CODE=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=
